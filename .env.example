# Copy to .env and fill in. .env is gitignored.

# Required for src/tools/narrate.ts and src/tools/elevenlabs-video.ts.
# The video tool uses the same key but requires the ElevenCreative Studio
# private-beta scope (request access at https://elevenlabs.io/contact-sales);
# until granted, /elevenlabs-video errors cleanly and the visualizer falls
# back to Veo.
ELEVENLABS_API_KEY=

# Optional: pin a default voice id (overrides references/usage/elevenlabs/voices.yaml)
# ELEVENLABS_DEFAULT_VOICE_ID=

# Optional: override the ElevenCreative video API endpoint path once
# ElevenLabs publishes official docs. Defaults to /v1/video-generation
# (provisional best-guess based on existing public REST conventions).
# ELEVENLABS_VIDEO_PATH=/v1/video-generation
# ELEVENLABS_VIDEO_STATUS_PATH=/v1/video-generation

# Required for src/tools/veo.ts (Veo video generation via the Gemini API)
# and src/tools/nano-banana.ts (Nano Banana image generation).
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional — opt into the Vertex AI backend for veo.ts instead of Gemini API.
# When set (and gcloud is authed), veo.ts uses `gcloud auth print-access-token`.
# GOOGLE_CLOUD_PROJECT=

# Claude OAuth is handled by the `claude` CLI itself — no key needed here.
